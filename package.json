{
  "name": "generic-repro-website",
  "version": "0.1.0",
  "description": "Generic reproducible Status Website",
  "author": "cen1",
  "license": "MIT",
  "private": true,
  "scripts": {
    "config": "node build-config.js",
    "prebuild": "npm run config",
    "dev": "npm run config && concurrently \"npm run sass:watch\" \"npm run build:watch\" \"node dev-server.js\"",
    "build": "browserify -t babelify src/index.js > public/bundle.js && npm run sass",
    "build:watch": "watchify -t babelify src/index.js -o public/bundle.js",
    "sass": "sass src/style.scss:public/bundle.css",
    "sass:watch": "sass --watch src/style.scss:public/bundle.css",
    "build:arch": "DISTRO=arch npm run build",
    "build:debian": "DISTRO=debian npm run build",
    "dev:arch": "DISTRO=arch npm run dev",
    "dev:debian": "DISTRO=debian npm run dev",
    "build:prod": "npm run config && npm run build:js:prod && npm run sass:prod",
    "build:js:prod": "browserify -t babelify src/index.js | terser --compress --mangle > public/bundle.js",
    "sass:prod": "sass --style=compressed src/style.scss:public/bundle.css",
    "build:prod:arch": "DISTRO=arch npm run build:prod",
    "build:prod:debian": "DISTRO=debian npm run build:prod"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "babelify": "^10.0.0",
    "budo": "^11.8.4",
    "bulma": "^1.0.4",
    "concurrently": "^9.2.0",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-collapsible": "^2.10.0",
    "react-dom": "^18.3.1",
    "sass": "^1.90.0",
    "terser": "^5.43.1",
    "watchify": "^4.0.0"
  },
  "browserslist": "> 0.25%, not dead"
}
